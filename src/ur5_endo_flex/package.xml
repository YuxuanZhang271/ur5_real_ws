<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur5_endo_flex</name>
  <version>1.0.0</version>
  <description>
    Real UR5 (CB3, PolyScope 3.15) arm control with a mounted endoscope and
    the endo_flex continuum chain present but unactuated. Ported from the
    ur5_sim_ws Gazebo stack; drives the robot through ur_robot_driver
    (scaled_joint_trajectory_controller) with live robot-state feedback.
  </description>
  <maintainer email="yuxuanzhang@todo.todo">yuxuanzhang</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- real robot driver stack (binary install) -->
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_calibration</exec_depend>

  <!-- description / bringup -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <!-- control nodes -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <!-- kinematics / python deps -->
  <exec_depend>kdl_parser_py</exec_depend>
  <exec_depend>urdfdom_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pykdl</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>python3-pynput</exec_depend>

  <!-- vendored endoscope mesh/link package -->
  <exec_depend>ur5_endoscope</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
