<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>endo_flex_control</name>
  <version>0.0.0</version>
  <description>
    Standalone flexible-endoscope (endo_flex) teleop and URDF. Vendored into
    ur5_real_ws from ur5_sim_ws; NOT launched in the real-robot bringup (the
    flex chain is present in the URDF but unactuated on real hardware).
  </description>
  <maintainer email="yuxuanzhang@todo.todo">yuxuanzhang</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>python3-pynput</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
